---
import SectionHeading from './SectionHeading.astro';
import { profile, content, stack, getLang } from '../data/profile';

const lang = getLang(Astro.currentLocale);
const t = content[lang];
const [lead, ...paragraphs] = t.about;

const stats =
  lang === 'es'
    ? [
        { value: '5+', label: 'años construyendo software' },
        { value: '15+', label: 'proyectos entregados' },
      ]
    : [
        { value: '5+', label: 'years building software' },
        { value: '15+', label: 'projects shipped' },
      ];
---

<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24 sm:py-32">
  <SectionHeading title={t.sections.about} />

  <div class="mt-12 grid gap-12 md:grid-cols-12 md:gap-10">
    <figure class="md:col-span-5" data-animate>
      <div class="overflow-hidden rounded-2xl bg-surface">
        <img
          src={profile.photo}
          alt={profile.name}
          width="853"
          height="1280"
          loading="lazy"
          decoding="async"
          class="aspect-4/5 w-full object-cover object-[50%_30%]"
        />
      </div>
      <figcaption class="mt-3 flex justify-between text-sm text-muted">
        <span>{profile.fullName}</span>
        <span>{t.location}</span>
      </figcaption>
    </figure>

    <div class="md:col-span-7 md:pl-6">
      <p class="text-2xl leading-snug font-medium tracking-tight text-ink sm:text-3xl" data-animate>
        {lead}
      </p>
      {
        paragraphs.map((paragraph) => (
          <p class="mt-6 text-lg leading-relaxed text-soft" data-animate>
            {paragraph}
          </p>
        ))
      }

      <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-line pt-8" data-animate>
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="display text-6xl sm:text-7xl">
                {s.value.replace('+', '')}<span class="text-accent">+</span>
              </dd>
              <dd class="mt-2 text-sm text-muted">{s.label}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-12 text-sm font-medium text-ink" data-animate>
        {lang === 'es' ? 'Herramientas que uso' : 'Tools I work with'}
      </p>
      <ul class="mt-4 flex flex-wrap gap-2" data-animate>
        {
          stack.map((tool) => (
            <li class="rounded-full border border-line px-3.5 py-1.5 text-sm text-soft transition-colors hover:border-accent hover:text-ink">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
