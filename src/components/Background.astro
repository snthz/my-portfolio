
<div
  class="pointer-events-none fixed inset-0 -z-10"
  aria-hidden="true"
  style="background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(255, 255, 255, 0.06), transparent 70%);"
>
</div>
<canvas
  id="bg-particles"
  class="pointer-events-none fixed inset-0 -z-10"
  aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('bg-particles') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  interface Particle {
    x: number;
    y: number;
    r: number;
    alpha: number;
    vx: number;
    vy: number;
    phase: number;
  }

  let particles: Particle[] = [];
  let width = 0;
  let height = 0;

  function init() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const count = Math.min(Math.round((width * height) / 22000), 80);
    particles = Array.from({ length: count }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      r: 0.6 + Math.random() * 1.2,
      alpha: 0.08 + Math.random() * 0.3,
      vx: (Math.random() - 0.5) * 0.12,
      vy: -0.04 - Math.random() * 0.12,
      phase: Math.random() * Math.PI * 2,
    }));
  }

  function draw(time: number) {
    ctx.clearRect(0, 0, width, height);
    for (const p of particles) {
      // Parpadeo suave por partícula
      const twinkle = 0.7 + 0.3 * Math.sin(time / 1600 + p.phase);
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(244, 244, 245, ${p.alpha * twinkle})`;
      ctx.fill();

      p.x += p.vx;
      p.y += p.vy;
      if (p.y < -4) p.y = height + 4;
      if (p.x < -4) p.x = width + 4;
      if (p.x > width + 4) p.x = -4;
    }
  }

  function loop(time: number) {
    draw(time);
    requestAnimationFrame(loop);
  }

  init();
  if (reducedMotion) {
    draw(0);
  } else {
    requestAnimationFrame(loop);
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      init();
      if (reducedMotion) draw(0);
    }, 150);
  });
</script>
