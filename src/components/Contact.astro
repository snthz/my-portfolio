---
import { profile, content, getLang } from '../data/profile';

const lang = getLang(Astro.currentLocale);
const t = content[lang];
const headline =
  lang === 'es'
    ? { line: 'Construyamos', em: 'algo grande.' }
    : { line: "Let's build", em: 'something great.' };
---

<section id="contact" class="mx-auto max-w-6xl scroll-mt-20 px-6 pt-24 pb-16 sm:pt-32">
  <div class="rounded-3xl bg-surface px-6 py-16 sm:px-12 sm:py-24">
    <p class="text-sm font-medium text-ink" data-animate>
      {t.sections.contact}
    </p>
    <h2 class="display mt-8 text-[clamp(3rem,10vw,8rem)]" data-animate>
      {headline.line}
      <br />
      <span class="accent-serif text-accent">{headline.em}</span>
    </h2>

    <div class="mt-12 grid gap-8 md:grid-cols-12" data-animate>
      <p class="text-lg leading-relaxed text-soft md:col-span-5">{t.contactBlurb}</p>
      <div class="md:col-span-7 md:text-right">
        <a
          href={`mailto:${profile.email}`}
          class="group inline-flex items-center gap-3 text-2xl font-semibold tracking-tight break-all text-ink transition-colors hover:text-accent sm:text-4xl"
        >
          {profile.email}
          <span
            class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ink text-base text-paper transition-[background-color,rotate] duration-300 group-hover:rotate-45 group-hover:bg-accent sm:size-12"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
        <ul class="mt-8 flex flex-wrap gap-2 md:justify-end">
          {
            profile.socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex rounded-full border border-line px-4 py-2 text-sm text-soft transition-colors hover:border-ink hover:text-ink"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<footer class="mx-auto max-w-6xl px-6">
  <div class="flex flex-col justify-between gap-3 border-t border-line py-8 text-sm text-muted sm:flex-row">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <a href="#top" class="link">{lang === 'es' ? 'Volver arriba ↑' : 'Back to top ↑'}</a>
  </div>
</footer>
