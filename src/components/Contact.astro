---
import SectionHeading from './SectionHeading.astro';
import { profile, content, getLang } from '../data/profile';

const t = content[getLang(Astro.currentLocale)];
---

<section
  id="contact"
  class="mx-auto grid max-w-4xl scroll-mt-24 gap-6 border-t border-line px-6 py-20 sm:grid-cols-[11rem_1fr] sm:gap-10"
>
  <SectionHeading title={t.sections.contact} />
  <div class="max-w-xl">
    <p class="text-lg leading-relaxed text-soft" data-animate>
      {t.contactBlurb}
    </p>
    <a
      href={`mailto:${profile.email}`}
      class="link mt-6 inline-block font-serif text-2xl break-all text-ink sm:text-3xl"
      data-animate
    >
      {profile.email}
    </a>
  </div>
</section>

<footer class="mx-auto max-w-4xl px-6">
  <div
    class="flex flex-col justify-between gap-3 border-t border-line py-8 text-sm text-muted sm:flex-row"
  >
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <div class="flex flex-wrap gap-x-5 gap-y-2">
      {
        profile.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
