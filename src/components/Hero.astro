---
import { Picture } from 'astro:assets';
import { profile, content, getLang } from '../data/profile';

const lang = getLang(Astro.currentLocale);
const t = content[lang];
const [first, ...rest] = profile.name.split(' ');
---

<section id="top" class="mx-auto max-w-6xl px-6 pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="flex flex-wrap items-center justify-between gap-3 text-sm" data-animate>
    <p class="text-soft">
      {lang === 'es' ? 'Disponible para proyectos' : 'Available for new projects'}
    </p>
    <p class="text-muted">
      {t.location}
      <span class="text-line">·</span>
      <span class="tabular-nums" data-local-time></span>
    </p>
  </div>

  <h1 class="display mt-10 text-[clamp(4.5rem,19vw,15rem)] sm:mt-14" aria-label={profile.name}>
    <span class="block overflow-hidden pb-[0.04em]" data-reveal aria-hidden="true">
      <span class="flex items-center gap-[0.14em]">
        {first}
        <Picture
          src={profile.photo}
          alt=""
          formats={['avif', 'webp']}
          widths={[160, 320, 576]}
          sizes="(min-width: 1263px) 288px, 23vw"
          loading="eager"
          class="h-[0.7em] w-[1.2em] rounded-full object-cover object-[50%_28%] ring-1 ring-line"
        />
      </span>
    </span>
    <span class="block overflow-hidden pb-[0.04em]" data-reveal aria-hidden="true">
      <span class="flex items-end md:justify-end">
        {rest.join(' ')}
        <span class="mb-[0.1em] ml-[0.04em] size-[0.15em] rounded-full bg-accent"></span>
      </span>
    </span>
  </h1>

  <div class="mt-12 grid gap-8 border-t border-line pt-8 md:grid-cols-12 md:gap-10" data-animate>
    <p class="accent-serif text-2xl leading-snug text-ink md:col-span-4 sm:text-3xl">
      {t.role}
    </p>
    <p class="text-lg leading-relaxed text-soft md:col-span-5">
      {t.tagline}
    </p>
    <div class="flex flex-wrap items-start gap-3 md:col-span-3 md:justify-end">
      <a
        href={`mailto:${profile.email}`}
        class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent"
      >
        {t.cta}
        <span class="transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>
      <a
        href={lang === 'es' ? '/es/cv' : '/cv'}
        class="inline-flex rounded-full border border-line px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-ink"
      >
        {lang === 'es' ? 'Ver CV' : 'View CV'}
      </a>
    </div>
  </div>

  <p class="mt-14 text-sm text-muted" data-animate>
    <a href="#game" class="group inline-flex items-center gap-2 transition-colors hover:text-ink">
      <span class="inline-block transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
      {t.gameHint}
    </a>
  </p>
</section>

<script>
  // Hora local en Honduras, para dar contexto a clientes de otras zonas
  const el = document.querySelector<HTMLElement>('[data-local-time]');
  if (el) {
    const format = new Intl.DateTimeFormat(document.documentElement.lang, {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Tegucigalpa',
    });
    const tick = () => (el.textContent = format.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }
</script>
