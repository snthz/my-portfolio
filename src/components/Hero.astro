---
import { profile, content, getLang } from '../data/profile';

const lang = getLang(Astro.currentLocale);
const t = content[lang];

const stats =
  lang === 'es'
    ? [
        { value: '5+', label: 'años de experiencia' },
        { value: '15+', label: 'proyectos entregados' },
      ]
    : [
        { value: '5+', label: 'years of experience' },
        { value: '15+', label: 'projects shipped' },
      ];
---

<section id="top" class="mx-auto max-w-4xl px-6 pt-36 pb-20 sm:pt-44">
  <div class="flex items-center gap-4" data-animate>
    <img
      src={profile.photo}
      alt={profile.name}
      width="640"
      height="640"
      loading="eager"
      class="size-14 rounded-full object-cover sm:size-16"
    />
    <p class="text-sm leading-snug text-muted">
      {t.location}
      <br />
      {lang === 'es' ? 'Disponible para proyectos' : 'Available for new projects'}
    </p>
  </div>

  <h1
    class="mt-10 max-w-3xl font-serif text-5xl leading-[1.05] font-medium tracking-tight text-ink sm:text-7xl"
    data-animate
  >
    {profile.name}
  </h1>
  <p class="mt-4 font-serif text-xl text-soft italic sm:text-2xl" data-animate>
    {t.role}
  </p>
  <p class="mt-6 max-w-xl text-lg leading-relaxed text-soft" data-animate>
    {t.tagline}
  </p>

  <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-animate>
    <a
      href={`mailto:${profile.email}`}
      class="inline-flex rounded-md bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent"
    >
      {t.cta}
    </a>
    <a href={lang === 'es' ? '/es/cv' : '/cv'} class="link text-sm font-medium text-ink">
      {lang === 'es' ? 'Ver CV' : 'View CV'}
    </a>
  </div>

  <div class="mt-14 grid max-w-xl grid-cols-2 gap-6 border-t border-line pt-6 sm:grid-cols-4" data-animate>
    {
      stats.map((s) => (
        <div>
          <p class="font-serif text-3xl text-ink">{s.value}</p>
          <p class="mt-1 text-sm text-muted">{s.label}</p>
        </div>
      ))
    }
    <div class="col-span-2 text-sm leading-relaxed">
      <p class="text-muted">{lang === 'es' ? 'En la web' : 'Elsewhere'}</p>
      <p class="mt-1 text-soft">
        {
          profile.socials.map((s, i) => (
            <>
              {i > 0 && <span class="text-line"> · </span>}
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="link">
                {s.label}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </div>

  <p class="mt-14 text-sm text-muted" data-animate>
    <a href="#game" class="link">{t.gameHint}</a>
  </p>
</section>
