---
import { content, getLang } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLang(Astro.currentLocale);
const t = content[lang].nav;
const home = lang === 'es' ? '/es/' : '/';

const links = [
  { href: `${home}#about`, label: t.about },
  { href: `${home}#projects`, label: t.projects },
  { href: `${home}#experience`, label: t.experience },
  { href: `${home}#contact`, label: t.contact },
  { href: lang === 'es' ? '/es/cv' : '/cv', label: 'CV' },
];

const languages = [
  { code: 'en', href: '/' },
  { code: 'es', href: '/es/' },
] as const;
---

<header
  class="fixed top-0 z-40 w-full border-b border-transparent transition-[background-color,border-color] duration-300 data-scrolled:border-line data-scrolled:bg-paper/85 data-scrolled:backdrop-blur-md"
  data-header
>
  <nav class="mx-auto max-w-6xl px-6" data-nav>
    <div class="flex items-center justify-between py-4">
      <!-- Logo tipo consola: prompt, nombre que se escribe solo y cursor -->
      <a
        href={`${home}#top`}
        class="group flex items-center text-base font-semibold tracking-tight text-ink"
        aria-label="Axl Santos"
        data-logo
      >
        <span
          class="mr-1.5 text-accent transition-transform duration-300 group-hover:translate-x-0.5"
          aria-hidden="true">&gt;</span
        >
        <span aria-hidden="true" data-logo-text>Axl Santos</span>
        <span class="logo-cursor ml-0.5 h-[1.1em] w-[0.45em] bg-accent" aria-hidden="true"></span>
      </a>

      <div class="flex items-center gap-6">
        <ul class="hidden items-center gap-6 sm:flex">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-soft transition-colors hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="flex items-center gap-1.5 text-sm">
          {
            languages.map((l, i) => (
              <>
                {i > 0 && <span class="text-line">/</span>}
                <a
                  href={l.href}
                  class:list={[
                    'uppercase transition-colors hover:text-accent',
                    l.code === lang ? 'font-medium text-ink' : 'text-muted',
                  ]}
                >
                  {l.code}
                </a>
              </>
            ))
          }
        </div>

        <ThemeToggle />

        <button
          type="button"
          class="flex size-8 flex-col items-center justify-center gap-1.5 sm:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menu"
          data-menu-toggle
        >
          <span
            class="h-px w-5 bg-ink transition-transform duration-300"
            data-menu-bar-top></span>
          <span
            class="h-px w-5 bg-ink transition-transform duration-300"
            data-menu-bar-bottom></span>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden pb-8 sm:hidden" data-menu-panel>
      <ul class="flex flex-col gap-3 border-t border-line pt-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="display block text-4xl transition-colors hover:text-accent"
                data-menu-link
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  .logo-cursor {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]')!;
  const panel = document.querySelector('[data-menu-panel]')!;
  const barTop = document.querySelector('[data-menu-bar-top]') as HTMLElement;
  const barBottom = document.querySelector(
    '[data-menu-bar-bottom]'
  ) as HTMLElement;

  const header = document.querySelector<HTMLElement>('[data-header]')!;

  // El nombre se escribe letra por letra al cargar y al pasar el mouse
  const logo = document.querySelector<HTMLElement>('[data-logo]')!;
  const logoText = logo.querySelector<HTMLElement>('[data-logo-text]')!;
  const name = logoText.textContent!;
  let typing: number | undefined;

  function type() {
    if (typing !== undefined) return;
    let i = 0;
    logoText.textContent = '';
    typing = window.setInterval(() => {
      logoText.textContent = name.slice(0, ++i);
      if (i < name.length) return;
      clearInterval(typing);
      typing = undefined;
    }, 70);
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    type();
    logo.addEventListener('pointerenter', type);
  }

  function setOpen(open: boolean) {
    header.toggleAttribute('data-open', open);
    syncHeader();
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('hidden', !open);
    barTop.style.transform = open
      ? 'translateY(3.5px) rotate(45deg)'
      : '';
    barBottom.style.transform = open
      ? 'translateY(-3.5px) rotate(-45deg)'
      : '';
  }

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Fondo del header solo después de hacer scroll (o con el menú abierto)
  function syncHeader() {
    header.toggleAttribute('data-scrolled', scrollY > 12 || header.hasAttribute('data-open'));
  }
  syncHeader();
  addEventListener('scroll', syncHeader, { passive: true });

  for (const link of document.querySelectorAll('[data-menu-link]')) {
    link.addEventListener('click', () => setOpen(false));
  }
</script>
