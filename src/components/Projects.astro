---
import SectionHeading from './SectionHeading.astro';
import { content, getLang } from '../data/profile';

const t = content[getLang(Astro.currentLocale)];
const featured = t.projects.filter((p) => p.featured);
const others = t.projects.filter((p) => !p.featured);
---

<section id="projects" class="mx-auto max-w-4xl scroll-mt-24 px-6 py-24">
  <SectionHeading number="02" title={t.sections.projects} />

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      featured.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-xl border border-line bg-surface p-7 transition-colors hover:border-accent/40"
          data-animate
        >
          <div class="flex items-start justify-between">
            <h3 class="text-xl font-semibold text-bright transition-colors group-hover:text-accent">
              {project.name}
            </h3>
            <span class="text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent">
              ↗
            </span>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-soft">
            {project.description}
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <li class="font-mono text-xs text-muted">{tag}</li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>

  <ul class="mt-4 grid gap-4 sm:grid-cols-3">
    {
      others.map((project) => (
        <li data-animate>
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex h-full flex-col rounded-xl border border-line p-5 transition-colors hover:border-accent/40 hover:bg-surface"
          >
            <h3 class="text-sm font-semibold text-bright transition-colors group-hover:text-accent">
              {project.name} <span class="text-muted">↗</span>
            </h3>
            <p class="mt-2 flex-1 text-xs leading-relaxed text-muted">
              {project.description}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
