---
interface Props {
  title: string;
  /** Texto corto a la derecha del título (ej. un contador o una nota). */
  aside?: string;
}

const { title, aside } = Astro.props;
---

<div
  class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b border-line pb-6"
  data-animate
>
  <h2 class="display text-5xl sm:text-7xl">{title}</h2>
  {aside && <p class="max-w-xs text-sm leading-relaxed text-muted">{aside}</p>}
</div>
