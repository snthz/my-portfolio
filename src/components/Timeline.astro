---
import SectionHeading from './SectionHeading.astro';
import { content, getLang } from '../data/profile';

const lang = getLang(Astro.currentLocale);
const t = content[lang];
---

<section id="experience" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24 sm:py-32">
  <SectionHeading
    title={t.sections.experience}
    aside={lang === 'es'
      ? 'Dónde he trabajado y lo que construí ahí.'
      : "Where I've worked and what I built there."}
  />

  <ol>
    {
      t.experience.map((job) => (
        <li class="grid gap-x-10 gap-y-3 border-b border-line py-10 md:grid-cols-12" data-animate>
          <p class="text-sm text-muted tabular-nums md:col-span-3 md:pt-2">{job.period}</p>

          <div class="md:col-span-6">
            <h3 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{job.company}</h3>
            <p class="accent-serif mt-1 text-xl text-accent">{job.role}</p>
            <p class="mt-4 max-w-xl leading-relaxed text-soft">{job.description}</p>
          </div>

          <div class="flex flex-col gap-4 md:col-span-3 md:items-end md:pt-2">
            <p class="text-sm text-muted md:text-right">{job.location}</p>
            <ul class="flex flex-wrap gap-1.5 md:justify-end">
              {job.tags.map((tag) => (
                <li class="rounded-full border border-line px-3 py-1 text-xs text-soft">{tag}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
